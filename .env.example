# 服务端生成回调、重定向、Sitemap 与 robots.txt 时使用的应用公开地址。
APP_URL=http://localhost:3000
# Vite 构建时注入浏览器端的应用公开地址，应与 APP_URL 保持一致。
VITE_APP_URL=http://localhost:3000

# 项目所有数据库连接统一使用的 PostgreSQL URL；默认连接 Compose 的 db 服务，也可替换为 Neon、Supabase 等远程连接串。
DATABASE_URL=postgresql://postgres:shipgo_local_password@db:5432/shipgo
# 数据库集成测试使用的独立连接串；运行测试前应改为专用测试数据库。
TEST_DATABASE_URL=

# Better Auth 用于签名会话与令牌的密钥，生产环境必须替换为新的随机值。
BETTER_AUTH_SECRET=shipgo-local-better-auth-secret-change-me
# 是否启用管理员演示只读模式。
ADMIN_DEMO_MODE=false
# 保护积分定时任务接口的共享密钥。
CRON_SECRET=shipgo-local-cron-secret

# 是否要求新用户验证邮箱；本地 Quick Start 关闭以避免依赖真实邮件服务。
EMAIL_VERIFICATION_ENABLED=false
# 是否允许邮箱和密码注册登录。
CREDENTIAL_AUTH_ENABLED=true
# 是否启用 Google OAuth；启用时必须同时配置 Google Client ID 与 Secret。
GOOGLE_AUTH_ENABLED=false
# 是否启用 GitHub OAuth；启用时必须同时配置 GitHub Client ID 与 Secret。
GITHUB_AUTH_ENABLED=false
# GitHub OAuth 应用的客户端 ID。
GITHUB_CLIENT_ID=
# GitHub OAuth 应用的客户端密钥。
GITHUB_CLIENT_SECRET=
# Google OAuth 应用的客户端 ID。
GOOGLE_CLIENT_ID=
# Google OAuth 应用的客户端密钥。
GOOGLE_CLIENT_SECRET=

# 浏览器端是否显示并启用 Turnstile 验证码。
VITE_TURNSTILE_CAPTCHA_ENABLED=false
# 浏览器端渲染 Turnstile 时使用的 Site Key。
VITE_TURNSTILE_SITE_KEY=
# 服务端是否校验 Turnstile 验证结果。
TURNSTILE_CAPTCHA_ENABLED=false
# 服务端校验 Turnstile 时使用的 Secret Key。
TURNSTILE_SECRET_KEY=

# 应用未指定语言时使用的默认语言。
VITE_DEFAULT_LOCALE=en
# 应用构建时启用的语言列表，使用英文逗号分隔。
VITE_ENABLED_LOCALES=en,zh
# 商品价格与支付界面显示的货币代码。
VITE_CURRENCY=USD
# 是否启用 TanStack Devtools 事件总线。
TANSTACK_DEVTOOLS_EVENT_BUS_ENABLED=false
# TanStack Devtools 事件总线监听端口。
TANSTACK_DEVTOOLS_EVENT_BUS_PORT=42069

# 邮件发送 Provider；当前生产环境校验要求使用 resend。
EMAIL_PROVIDER=resend
# 应用发送邮件时使用的发件人地址。
EMAIL_FROM=local@shipgo.test
# Resend API Key；本地启动使用占位值，发送真实邮件前必须替换。
RESEND_API_KEY=re_local_placeholder
# Resend Newsletter 订阅使用的 Audience ID。
RESEND_AUDIENCE_ID=
# Newsletter Provider，可选 resend 或 beehiiv。
NEWSLETTER_PROVIDER=resend
# Beehiiv API Key，仅 NEWSLETTER_PROVIDER=beehiiv 时使用。
BEEHIIV_API_KEY=
# Beehiiv Publication ID，仅 NEWSLETTER_PROVIDER=beehiiv 时使用。
BEEHIIV_PUBLICATION_ID=
# 联系表单消息的接收邮箱。
CONTACT_EMAIL=local@shipgo.test

# 支付 Provider，可选 stripe 或 creem。
PAYMENT_PROVIDER=stripe
# Stripe 服务端 API Key；本地启动使用占位值，调用真实支付前必须替换。
STRIPE_SECRET_KEY=sk_test_local_placeholder
# Stripe Webhook 签名密钥；本地启动使用占位值，接收真实 Webhook 前必须替换。
STRIPE_WEBHOOK_SECRET=whsec_local_placeholder
# Creem 服务端 API Key，仅 PAYMENT_PROVIDER=creem 时使用。
CREEM_API_KEY=
# Creem Webhook 签名密钥，仅 PAYMENT_PROVIDER=creem 时使用。
CREEM_WEBHOOK_SECRET=
# 是否让 Creem Provider 使用测试服务器。
CREEM_DEBUG=true
# Stripe Pro 月付价格 ID。
STRIPE_PRO_MONTHLY_PRICE_ID=price_local_pro_monthly
# Stripe Pro 年付价格 ID。
STRIPE_PRO_YEARLY_PRICE_ID=price_local_pro_yearly
# Stripe Lifetime 价格 ID。
STRIPE_LIFETIME_PRICE_ID=price_local_lifetime
# Stripe Basic 积分包价格 ID。
STRIPE_CREDIT_BASIC_PRICE_ID=price_local_credit_basic
# Stripe Standard 积分包价格 ID。
STRIPE_CREDIT_STANDARD_PRICE_ID=price_local_credit_standard
# Stripe Premium 积分包价格 ID。
STRIPE_CREDIT_PREMIUM_PRICE_ID=price_local_credit_premium
# Stripe Enterprise 积分包价格 ID。
STRIPE_CREDIT_ENTERPRISE_PRICE_ID=price_local_credit_enterprise
# 浏览器端展示 Stripe Pro 月付方案时使用的价格 ID。
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_local_pro_monthly
# 浏览器端展示 Stripe Pro 年付方案时使用的价格 ID。
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_local_pro_yearly
# 浏览器端展示 Stripe Lifetime 方案时使用的价格 ID。
VITE_STRIPE_LIFETIME_PRICE_ID=price_local_lifetime

# S3 兼容存储的 Access Key ID。
STORAGE_ACCESS_KEY_ID=
# S3 兼容存储的 Secret Access Key。
STORAGE_SECRET_ACCESS_KEY=
# S3 兼容存储的 Region，Cloudflare R2 等服务可使用 auto。
STORAGE_REGION=auto
# S3 兼容存储中保存上传文件的 Bucket 名称。
STORAGE_BUCKET_NAME=
# S3 兼容存储的 API Endpoint。
STORAGE_ENDPOINT=
# 浏览器访问已上传文件时使用的公开基础地址。
STORAGE_PUBLIC_URL=

# Discord 通知使用的 Webhook URL。
DISCORD_WEBHOOK_URL=
# 飞书通知使用的 Webhook URL。
FEISHU_WEBHOOK_URL=
# 服务端 Crisp 集成使用的 Website ID。
CRISP_WEBSITE_ID=
# Google Analytics Measurement ID。
VITE_GA_MEASUREMENT_ID=
# 浏览器端 Crisp 聊天组件使用的 Website ID。
VITE_CRISP_WEBSITE_ID=
# Umami Analytics Website ID。
VITE_UMAMI_WEBSITE_ID=
# Umami Analytics 脚本地址。
VITE_UMAMI_SCRIPT_URL=
# Plausible Analytics 统计域名。
VITE_PLAUSIBLE_DOMAIN=
# OpenPanel Analytics Client ID。
VITE_OPENPANEL_CLIENT_ID=
# Microsoft Clarity Project ID。
VITE_CLARITY_PROJECT_ID=
# Ahrefs Analytics 脚本地址。
VITE_AHREFS_SCRIPT_URL=
# DataFast Analytics 脚本地址。
VITE_DATAFAST_SCRIPT_URL=
# Seline Analytics 脚本地址。
VITE_SELINE_SCRIPT_URL=
# PostHog Project API Key，仅暴露浏览器端公开 Key，不填写则不加载 PostHog。
VITE_POSTHOG_KEY=
# PostHog API Host，例如 https://us.i.posthog.com 或自托管地址。
VITE_POSTHOG_HOST=

# 发布冒烟检查请求的目标地址；为空时脚本回退到 APP_URL。
SMOKE_BASE_URL=http://localhost:3000
