{
  "name": "shipgo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "tanstack-start",
    "react",
    "starter",
    "fullstack",
    "authentication",
    "i18n",
    "shadcn-ui",
    "drizzle",
    "tailwindcss",
    "saas template",
    "shipgo"
  ],
  "scripts": {
    "dev": "rm -rf node_modules/.vite && vite dev --port 3000",
    "build": "tsx scripts/generate-robots.ts && NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "pnpm content:build && tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "check": "biome check",
    "content:build": "fumadocs-mdx source.config.ts .source && intlayer build",
    "email:preview": "email dev --port ${PORT:-3006} --dir src/shared/components/email",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:check-compat": "tsx scripts/check-db-compat.ts",
    "distribute-credits": "tsx scripts/distribute-credits.ts",
    "users:query": "tsx scripts/query-users.ts",
    "contacts:query": "tsx scripts/query-contacts.ts",
    "payments:repair": "tsx scripts/repair-payments.ts",
    "smoke:release": "tsx scripts/smoke-release.ts",
    "verify:release": "pnpm check && pnpm deps:check && pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "vitest run src/repositories/repositories.integration.test.ts",
    "deps:check": "knip --dependencies"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.4.1",
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.4",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.157.16",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.157.16",
    "@types/mdx": "^2.0.13",
    "@unpic/react": "^1.0.2",
    "beautiful-mermaid": "^0.1.3",
    "better-auth": "^1.4.10",
    "better-auth-harmony": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "creem": "^1.4.4",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.0",
    "fumadocs-core": "^16.4.7",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.4.7",
    "intlayer": "^7.5.14",
    "lucide-react": "^0.561.0",
    "motion": "^12.26.2",
    "nitro": "npm:nitro-nightly@latest",
    "nuqs": "^2.8.6",
    "ofetch": "^1.5.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intlayer": "^7.5.14",
    "resend": "^6.7.0",
    "s3mini": "^0.9.1",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "tanstack-theme-kit": "^0.2.1",
    "tw-animate-css": "^1.3.6",
    "vite-intlayer": "^7.5.14",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tanstack/devtools-vite": "^0.3.11",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^16.0.0",
    "jsdom": "^27.0.0",
    "knip": "^5.82.1",
    "react-email": "^5.2.5",
    "tsx": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5"
  }
}
